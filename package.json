{
  "name": "next-supabase-saas-kit-turbo-lite",
  "version": "1.0.1",
  "private": true,
  "author": {
    "name": "MakerKit",
    "url": "https://makerkit.dev"
  },
  "sideEffects": false,
  "scripts": {
    "preinstall": "pnpm run --filter scripts requirements",
    "postinstall": "manypkg fix",
    "build": "turbo build --cache-dir=.turbo",
    "clean": "git clean -xdf node_modules dist .next",
    "clean:workspaces": "turbo clean",
    "dev": "cross-env FORCE_COLOR=1 turbo dev --parallel",
    "lint:fix": "oxlint --fix",
    "typecheck": "turbo typecheck --cache-dir=.turbo",
    "test": "turbo test --cache-dir=.turbo --filter=!web-e2e",
    "update": "pnpm update -r",
    "syncpack:list": "pnpm dlx syncpack list-mismatches",
    "syncpack:fix": "pnpm dlx syncpack fix-mismatches",
    "supabase:web:start": "pnpm --filter web supabase:start",
    "supabase:web:stop": "pnpm --filter web supabase:stop",
    "supabase:web:typegen": "pnpm --filter web supabase:typegen",
    "supabase:web:reset": "pnpm --filter web supabase:reset",
    "lint": "oxlint",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "healthcheck": "oxlint --fix && oxfmt && pnpm run typecheck && manypkg fix",
    "test:db": "pnpm --filter web test:db",
    "test:e2e": "pnpm --filter web-e2e test",
    "check": "pnpm typecheck && pnpm lint && pnpm format && pnpm test && pnpm test:db && pnpm --filter web build:test",
    "prepare": "husky",
    "studio:secrets:init": "node tooling/scripts/src/secrets-init.mjs",
    "studio:setup": "node tooling/scripts/src/studio-setup.mjs",
    "studio:doctor": "node tooling/scripts/src/studio-doctor.mjs",
    "studio:new": "node tooling/scripts/src/studio-new.mjs",
    "studio:sync": "node tooling/scripts/src/studio-sync.mjs",
    "studio:audit": "node tooling/scripts/src/studio-audit.mjs"
  },
  "devDependencies": {
    "@manypkg/cli": "catalog:",
    "@turbo/gen": "catalog:",
    "cross-env": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "lint-staged": {
    "*.{js,mjs,jsx,ts,tsx}": [
      "oxlint --fix --no-error-on-unmatched-pattern",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{json,jsonc,md,css,yaml,yml}": [
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.18.0"
}
