{
  "permissions": {
    "deny": [
      "Read(./**/.env.local)",
      "Read(./**/.env.*.local)",
      "Read(./**/.env.keys)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/tooling/scripts/src/agent/hook-bash.mjs\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/tooling/scripts/src/agent/hook-file.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/tooling/scripts/src/agent/hook-stop.mjs\"",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
