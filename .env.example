# studio-template – alle Umgebungsvariablen.
#
# Ladereihenfolge (apps/web, Skript `with-env`, dotenvx):
#   1. ${STUDIO_SECRETS_DIR}/${STUDIO_SECRETS_FILE}  gemeinsame, verschlüsselte Secrets (separates Repo)
#   2. apps/web/${STUDIO_LOCAL_ENV_FILE}             projektspezifisch, gewinnt bei Konflikten (--overload)
# Next.js lädt zusätzlich die committeten, nicht geheimen apps/web/.env, .env.development, .env.production.
# Tests (`build:test`, `start:test`) laden nur apps/web/.env.test (lokale Supabase-Demo-Keys).
#
# Markierung: [shared] gehört in studio-secrets/.env.shared, [local] in apps/web/.env.local,
# [public] steht bereits in apps/web/.env* und muss nur bei Bedarf überschrieben werden.

# ---------------------------------------------------------------------------
# Env-Loading (als Shell-Variable setzen, nicht in eine Datei)
# Verzeichnis des Secrets-Repos; relative Pfade gelten ab apps/web.
STUDIO_SECRETS_DIR=../../../studio-secrets
# Dateiname der gemeinsamen Secrets
STUDIO_SECRETS_FILE=.env.shared
# Dateiname der projektspezifischen Datei in apps/web
STUDIO_LOCAL_ENV_FILE=.env.local

# ---------------------------------------------------------------------------
# Bootstrap `pnpm studio:new` [shared] – nur das Skript nutzt diese Werte, nicht die App
# Schlüssel zum Entschlüsseln von .env.shared; liegt im OS-Schlüsselbund, nur für CI als Variable setzen
DOTENV_PRIVATE_KEY_SHARED=
# Supabase → Account → Access Tokens
SUPABASE_ACCESS_TOKEN=
# Supabase → Organization → Settings (Slug/ID)
SUPABASE_ORG_ID=
# Vercel → Account Settings → Tokens
VERCEL_TOKEN=
# Team-Slug bei Vercel-Teams, leer für den persönlichen Account
VERCEL_SCOPE=
# Optional: Google-Login, wird in Supabase Auth eingetragen (Redirect-URI siehe docs/launch-checklist.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Site [public]
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_PRODUCT_NAME=Studio

# ---------------------------------------------------------------------------
# Supabase [local] – von `pnpm studio:new` gesetzt; lokal stehen die Demo-Keys in apps/web/.env.development
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Nur serverseitig verwenden, umgeht RLS
SUPABASE_SERVICE_ROLE_KEY=

# Auth-Methoden [public]
NEXT_PUBLIC_AUTH_PASSWORD=true
NEXT_PUBLIC_AUTH_MAGIC_LINK=true
# Google-Button anzeigen; setzt `pnpm studio:new`, wenn GOOGLE_CLIENT_ID/SECRET vorhanden sind
NEXT_PUBLIC_AUTH_GOOGLE=false

# ---------------------------------------------------------------------------
# Stripe [local]
# Secret Key (Testmodus: sk_test_…), nur serverseitig
STRIPE_SECRET_KEY=
# Webhook-Secret (whsec_…): lokal aus `stripe listen`, in Produktion vom Dashboard-Endpoint
STRIPE_WEBHOOK_SECRET=
# Price-ID (price_…) des Produkts `pro` aus apps/web/config/studio.config.ts
STRIPE_PRICE_PRO=

# ---------------------------------------------------------------------------
# E-Mail (Resend)
# API-Key (re_…); ohne Key wird lokal nur geloggt, in Produktion schlägt der Versand fehl
RESEND_API_KEY= # [shared]
# Absender, Domain muss bei Resend verifiziert sein
EMAIL_FROM="Produkt <hallo@deine-domain.de>" # [local]

# ---------------------------------------------------------------------------
# Hintergrund-Jobs [local] – von `pnpm studio:new` erzeugt (z. B. `openssl rand -hex 32`)
# Bearer-Token für /api/jobs/worker (Vercel Cron und pg_cron); gleicher Wert wie das Vault-Secret `cron_secret`
CRON_SECRET=

# ---------------------------------------------------------------------------
# Fehler-Monitoring (Sentry) – ohne DSN ist Sentry aus (kein Init, kein Netzwerk)
# Empfohlen: EU-Region (de.sentry.io). Server-DSN [shared]
SENTRY_DSN=
# Client-DSN [public] (wird beim Build eingebettet, meist derselbe Wert wie SENTRY_DSN)
NEXT_PUBLIC_SENTRY_DSN=

# ---------------------------------------------------------------------------
# Admin [shared]
# Kommagetrennte E-Mail-Adressen, die /admin sehen dürfen; leer = niemand
ADMIN_EMAILS=

# ---------------------------------------------------------------------------
# Analytics (cookielos) [public]
# plausible | umami | off (ohne Angabe: off)
NEXT_PUBLIC_ANALYTICS_PROVIDER=off
# Plausible: Domain und optional eigene Script-URL (Default https://plausible.io/js/script.js)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_SRC=
# Umami: Website-ID und Script-URL (Default https://cloud.umami.is/script.js)
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SRC=

# ---------------------------------------------------------------------------
# Impressum und Datenschutz [shared]
# Fehlt ein Pflichtwert, zeigen die Seiten einen sichtbaren Platzhalter
LEGAL_NAME=
LEGAL_STREET=
LEGAL_ZIP_CITY=
LEGAL_EMAIL=
LEGAL_PHONE=
# Optional
LEGAL_VAT_ID=
# Verantwortlich für den Inhalt (§ 18 Abs. 2 MStV)
LEGAL_RESPONSIBLE=

# ---------------------------------------------------------------------------
# KI-Schicht (lib/ai)
# anthropic | openai-compatible (ohne Angabe: anthropic) [local]
AI_PROVIDER=anthropic
# Modell-ID; ohne Angabe claude-haiku-5-5 [local]
AI_MODEL=
# Nur openai-compatible: Basis-URL, z. B. http://localhost:11434/v1 für Ollama (Default https://api.openai.com/v1) [local]
AI_BASE_URL=
# [shared]
ANTHROPIC_API_KEY=
# Bei lokalen Servern ohne Auth leer lassen [shared]
OPENAI_API_KEY=
