{
  "$schema": "https://turborepo.org/schema.json",
  "globalDependencies": ["**/.env"],
  "ui": "stream",
  "globalEnv": [
    "NEXT_PUBLIC_PRODUCT_NAME",
    "NEXT_PUBLIC_SITE_URL",
    "LOGGER",
    "CAPTCHA_SECRET_TOKEN"
  ],
  "tasks": {
    "topo": {
      "dependsOn": ["^topo"]
    },
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "LEGAL_*",
        "STRIPE_*",
        "SUPABASE_SERVICE_ROLE_KEY",
        "CRON_SECRET",
        "RESEND_API_KEY",
        "EMAIL_FROM",
        "ADMIN_EMAILS",
        "AI_PROVIDER",
        "AI_BASE_URL",
        "ANTHROPIC_API_KEY",
        "OPENAI_API_KEY",
        "CSP_REPORT_ONLY"
      ],
      "outputs": [".next/**", "!.next/cache/**", "next-env.d.ts"]
    },
    "dev": {
      "persistent": true,
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^topo"],
      "outputs": ["node_modules/.cache/tsbuildinfo.json"]
    },
    "test": {
      "dependsOn": ["^topo"]
    },
    "clean": {
      "cache": false
    },
    "//#clean": {
      "cache": false
    },
    "license#dev": {
      "outputLogs": "errors-only"
    }
  }
}
